# 复制为 .deploy.env（勿提交，已加入 .gitignore）
#
# bot + API（均为服务器 go run + local 配置）:
#   cp .deploy.env.example .deploy.env
#   chmod +x deploy-service.sh deploy-api.sh
#   ./deploy-service.sh master    # --run_bot=true
#   ./deploy-api.sh master        # --run_bot=false
#
SSH_HOST=216.195.208.199
SSH_PORT=22
SSH_USER=root
SSH_PASS=your_ssh_password

MALL_APP_DIR=/www/wwwroot/AI-Agent-Paper

# bot 单进程（main.go --run_bot=true 时不监听 HTTP）
MALL_BOT_RUN_CONF=local
# deploy-service.sh 会在服务器上 go run；仅 deploy user 走 bin 时可设 0
PAPER_USE_GO_RUN=1
# 官方包装在 /usr/local/go 时可不设；非默认路径时指定：
PAPER_GO_ROOT=/usr/local/go
# 自动安装 Go 版本（无 go 时）：PAPER_GO_VERSION=1.22.5

# 仅 deploy user 模式时使用
MALL_USER_RUN_CONF=local
MALL_USER_PORT=8886

MALL_WEB_ROOT=front/web-pc
MALL_WEB_DIST=front/web-pc/dist
WEB_BUILD_CMD="pnpm install && pnpm build"
VITE_API_BASE_URL=https://your-api.example.com

GIT_FETCH_TIMEOUT=120
GIT_REPO_URL=git@github.com:qingpeng2016/AI-Agent-Paper.git
