# 复制为 .deploy.env（勿提交）
#
# 本机 SSH 跳板（密码登录：sshpass 或 macOS 自带 expect）
# 前端: 本机构建 dist → git push → 服务器 pull（CentOS7 无法在服务器跑 Node）
# 后端: 仍在服务器 go build
#   ./deploy-frontend.sh master deploy
#   ./deploy-backend.sh  master deploy user
#
SSH_HOST=your.server.ip
SSH_PORT=22
SSH_USER=root
SSH_PASS=your_ssh_password

MALL_APP_DIR=/www/wwwroot/AI-Token-Mall

MALL_USER_RUN_CONF=prod
MALL_BOT_RUN_CONF=prod
MALL_USER_PORT=8886

MALL_WEB_ROOT=front/apps
MALL_WEB_DIST=front/apps/web-pc/dist
WEB_BUILD_CMD="pnpm install && pnpm build:pc"
# 生产 API 根地址（写入 web-pc/.env.production 后打包，不要末尾 /）
VITE_API_BASE_URL=https://api.niceboxs.com

GIT_FETCH_TIMEOUT=120
